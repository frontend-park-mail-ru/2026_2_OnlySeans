{
  "name": "frame",
  "version": "1.0.0",
  "private": true,
  "description": "Frame: фронтенд кинопоиска команды OnlySeans",
  "scripts": {
    "start": "node server.js",
    "lint": "eslint src server.js",
    "dev": "webpack serve --mode development",
    "build": "npm run typecheck && webpack --mode production",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "test:sw": "npm run build && node test-service-worker.cjs",
    "test:offline": "npm run test:sw && node test-offline-edits.cjs"
  },
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@eslint/markdown": "^8.0.3",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "8.5.32",
    "style-loader": "^4.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "webpack": "^5.112.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^6.1.0"
  },
  "dependencies": {
    "handlebars": "^4.7.9"
  }
}
