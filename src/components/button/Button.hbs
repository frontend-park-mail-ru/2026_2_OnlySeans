{{#if href}}
  <a class='button button--{{variant}}' href='{{href}}' data-link>{{#if imageBefore}}<img
        src='{{imageBefore}}'
        alt=''
      />{{else if iconBefore}}{{icon iconBefore}}{{/if}}{{text}}</a>
{{else}}
  <button class='button button--{{variant}}' type='{{type}}'>{{#if imageBefore}}<img
        src='{{imageBefore}}'
        alt=''
      />{{else if iconBefore}}{{icon iconBefore}}{{/if}}{{text}}</button>
{{/if}}