<a class='logo' href='/' data-link aria-label='Frame, на главную'>
  {{#if compact}}
    <img class='logo__mobile' src='{{mobile}}' width='108' height='30' alt='' />
  {{else}}
    <img class='logo__mark' src='{{mark}}' width='30' height='30' alt='' />
    <span class='logo__word'>
      <img src='{{letter}}' width='11' height='18' alt='' />
      <img src='{{word}}' width='57' height='15' alt='' />
    </span>
  {{/if}}
</a>