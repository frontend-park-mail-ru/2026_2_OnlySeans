<div class='section-heading'>
  {{#if primary}}<h1 class='section-heading__title'><img
        class='section-heading__star'
        src='{{star}}'
        alt=''
      />{{title}}</h1>{{else}}<h2 class='section-heading__title'><img
        class='section-heading__star'
        src='{{star}}'
        alt=''
      />{{title}}</h2>{{/if}}
  {{#if count}}<span class='section-heading__count'>{{count}}</span>{{/if}}
  {{#if link}}<a
      class='section-heading__link'
      href='{{link.href}}'
      data-link
    >{{link.text}}</a>{{/if}}
  <div data-slot='tools'></div>
</div>