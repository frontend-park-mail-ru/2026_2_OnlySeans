<section class='empty-state {{modifier}}' aria-live='polite'>
  {{#if token}}<span class='empty-state__token'><img
        class='empty-state__illustration'
        src='{{illustration}}'
        width='48'
        height='48'
        alt=''
      /></span>{{else}}<img
      class='empty-state__illustration'
      src='{{illustration}}'
      width='140'
      height='120'
      alt=''
    />{{/if}}
  {{#if unit}}<span class='empty-state__zero' aria-hidden='true'>0</span><span
      class='empty-state__unit'
    >{{unit}}</span><span class='empty-state__accent' aria-hidden='true'></span>{{/if}}
  {{#if secondary}}<h2 class='empty-state__title'>{{title}}</h2>{{else}}<h1
      class='empty-state__title'
    >{{title}}</h1>{{/if}}
  <p class='empty-state__text'>{{text}}</p>
  {{#if canRetry}}<button class='empty-state__button' type='button'>{{#if
        button
      }}{{button}}{{else}}Обновить{{/if}}</button>{{/if}}
  {{#if personState}}<div class='empty-state__actions'><a
        class='empty-state__home empty-state__home--primary'
        href='{{href}}'
        data-link
      >{{linkText}}</a><a class='empty-state__home' href='/' data-link>На главную</a></div>{{else}}
    {{#if homeLink}}<a class='empty-state__home' href='/' data-link>На главную</a>{{/if}}
    {{#if href}}<a class='empty-state__home' href='{{href}}' data-link>{{linkText}}</a>{{/if}}
  {{/if}}
  {{#if code}}<p class='empty-state__code'>Код ошибки {{code}}</p>{{/if}}
</section>