<div class='upcoming-page'>
  <div data-slot='heading'></div>
  <div class='upcoming-page__regions'><span id='release-region-label'>Дата выхода</span><nav
      aria-labelledby='release-region-label'
    >{{#each regions}}<a
          href='{{href}}'
          data-link
          aria-current='{{current}}'
        >{{label}}</a>{{/each}}</nav></div>
  <div class='upcoming-page__toolbar'>
    <div class='upcoming-page__months'>{{#if previous}}<a
          href='{{previousHref}}'
          data-link
          aria-label='Предыдущий месяц'
        >{{icon 'arrow-left'}}</a>{{/if}}<h2>{{title}}</h2>{{#if next}}<a
          href='{{nextHref}}'
          data-link
          aria-label='Следующий месяц'
        >{{icon 'arrow-right'}}</a>{{/if}}</div>
    <label class='upcoming-page__picker'><span class='visually-hidden'>Месяц</span><input
        type='month'
        name='month'
        min='1900-01'
        max='2099-12'
        aria-describedby='month-error'
      /></label>
    <nav aria-label='Вид расписания'>{{#each views}}<a
          href='{{href}}'
          data-link
          aria-current='{{current}}'
        >{{label}}</a>{{/each}}</nav>
  </div>
  <p id='month-error' data-month-error aria-live='polite'></p>
  {{#if loading}}<p role='status' aria-live='polite'>Загружаем премьеры…</p>{{/if}}
  {{#unless list}}<div
      class='upcoming-page__calendar'
      aria-label='Календарь премьер {{regionLabel}}'
    >
      {{#each weekdays}}<span class='upcoming-page__weekday'>{{this}}</span>{{/each}}
      {{#each days}}<div
          class='upcoming-page__day'
          data-current='{{current}}'
          data-today='{{today}}'
        ><time datetime='{{date}}'>{{day}}</time>
          {{#each releases}}<a class='upcoming-page__release' href='/film/{{film.id}}' data-link>
            {{#if film.poster}}<img src='{{film.poster}}' alt='' loading='lazy' />{{/if}}
            <span>{{film.title}}</span>
          </a>{{/each}}
        </div>{{/each}}
    </div>{{/unless}}
  {{#if list}}<div class='upcoming-page__list'>
    {{#each groups}}<section>
      <h3><time datetime='{{date}}'>{{label}}</time></h3>
      {{#each releases}}<a class='upcoming-page__release' href='/film/{{film.id}}' data-link>
        {{#if film.poster}}<img src='{{film.poster}}' alt='' loading='lazy' />{{/if}}
        <span>{{film.title}}</span>
      </a>{{/each}}
    </section>{{/each}}
  </div>{{/if}}
  <div data-slot='state'></div>
</div>