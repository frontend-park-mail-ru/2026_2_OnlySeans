<section class='library-list-page__guest'>
  <div class='library-list-page__guest-art' aria-hidden='true'>
    <img class='library-list-page__guest-orbit' src='{{orbit}}' alt='' />
    <i class='library-list-page__guest-card library-list-page__guest-card--left'></i>
    <i class='library-list-page__guest-card library-list-page__guest-card--right'></i>
    <img class='library-list-page__guest-glow' src='{{glow}}' alt='' />
    <img class='library-list-page__guest-disc' src='{{disc}}' alt='' />
    <img class='library-list-page__guest-clock' src='{{symbol}}' alt='' />
    <img class='library-list-page__guest-lock-disc' src='{{lockDisc}}' alt='' />
    <img class='library-list-page__guest-lock' src='{{lock}}' alt='' />
    <img class='library-list-page__guest-spark-one' src='{{sparkOne}}' alt='' />
    <img class='library-list-page__guest-spark-two' src='{{sparkTwo}}' alt='' />
    <img class='library-list-page__guest-spark-three' src='{{sparkThree}}' alt='' />
  </div>
  <h2>{{title}}</h2><p>{{text}}</p>
  <div class='library-list-page__guest-actions'>
    <a href='{{loginHref}}' data-link>Войти</a>
    <a href='{{registerHref}}' data-link>Создать аккаунт</a>
  </div>
</section>