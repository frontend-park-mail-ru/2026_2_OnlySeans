<div class="my-collection">
  <div data-slot="back"></div>
  {{#if collection}}
    <div class="my-collection__actions">
      <button class="text-action" type="button" data-action="rename">{{icon "edit"}}Переименовать</button>
      <button class="text-action text-action--danger" type="button" data-action="delete">
        {{icon "trash"}}Удалить коллекцию
      </button>
    </div>
  {{/if}}
  <div data-slot="feed"></div>
</div>
