<form class='review-form' novalidate aria-busy='{{busy}}'>
  <span class='review-form__label'>{{#if editing}}Ваш отзыв{{else}}Написать отзыв{{/if}}</span>
  <input
    class='review-form__title'
    name='title'
    type='text'
    aria-label='Заголовок отзыва'
    aria-describedby='{{id}}-title-error'
    aria-invalid='false'
    placeholder='Заголовок'
    value='{{title}}'
  />
  <span
    class='review-form__error'
    id='{{id}}-title-error'
    data-field-error='title'
    aria-live='polite'
  ></span>
  <textarea
    class='review-form__text'
    name='text'
    rows='5'
    aria-label='Текст отзыва'
    aria-describedby='{{id}}-text-error'
    aria-invalid='false'
    placeholder='Что вы думаете об этом {{what}}е?'
  >{{text}}</textarea>
  <span
    class='review-form__error'
    id='{{id}}-text-error'
    data-field-error='text'
    aria-live='polite'
  ></span>
  <p class='review-form__error' role='alert' data-error>{{error}}</p>
  <div class='review-form__bar'>
    <label class='review-form__spoiler'>
      <input class='review-form__checkbox' type='checkbox' name='spoiler' />
      Есть спойлеры
    </label>
    <output class='review-form__counter' name='counter'></output>
  </div>
  {{#if syncStatus}}<p class='review-form__sync' role='status'>{{syncStatus}}</p>{{/if}}
  <div class='review-form__actions'>
    <button class='review-form__save' type='submit' name='save' disabled>{{#if
        busy
      }}Отправляем…{{else if editing}}Сохранить{{else}}Опубликовать{{/if}}</button>
    {{#if canCancel}}
      <button class='review-form__cancel' type='button' name='cancel'>Отмена</button>
    {{/if}}
    {{#if editing}}
      <button class='review-form__remove' type='button' name='delete'>Удалить отзыв</button>
    {{/if}}
  </div>
</form>