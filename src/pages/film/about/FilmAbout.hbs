<div class="film-about">
  <section class="film-about__panel" aria-labelledby="film-about-title">
    <h2 class="film-about__title" id="film-about-title">О фильме</h2>
    {{#if film.description}}<p class="film-about__description">{{film.description}}</p>{{/if}}
    <dl class="film-about__details">
      {{#each details}}
        <div class="film-about__row">
          <dt class="film-about__term">{{term}}</dt>
          <dd class="film-about__value">{{value}}</dd>
        </div>
      {{/each}}
    </dl>
  </section>
  <div data-slot="people"></div>
  <div data-slot="rating"></div>
  <div data-slot="reviews"></div>
  <section class="film-about__similar" aria-label="Похожие">
    <div data-slot="similar-heading"></div>
    <div data-slot="similar"></div>
  </section>
</div>
