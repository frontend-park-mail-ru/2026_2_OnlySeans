<section class="film-rating" aria-labelledby="film-rating-title">
  <h2 class="film-rating__title" id="film-rating-title">Оценка</h2>
  <div class="film-rating__columns">
    <div class="film-rating__audience">
      <span class="film-rating__average" data-ref="average" {{#unless average}}hidden{{/unless}}>{{average}}</span>
      <span class="film-rating__count" data-ref="count">{{audience}}</span>
    </div>
    <div class="film-rating__mine">
      {{#if user}}
        <span class="film-rating__label" id="film-rating-mine">
          Ваша оценка<span data-ref="mineBox" {{#unless mine}}hidden{{/unless}}>: <span class="film-rating__value" data-ref="mine">{{mine}}</span></span>
        </span>
        <div data-slot="scale"></div>
        <button class="film-rating__reset" type="button" data-ref="reset">Убрать оценку</button>
      {{else}}
        <p class="film-rating__guest">
          Чтобы поставить оценку, <a class="film-rating__login" href="{{loginHref}}" data-link>войдите в аккаунт</a>.
        </p>
      {{/if}}
    </div>
  </div>
</section>
