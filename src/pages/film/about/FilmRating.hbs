<section class='film-rating' aria-label='Оценка зрителей'>
  <div class='film-rating__summary'>
    <img class='film-rating__star' src='{{star}}' alt='' />
    <div class='film-rating__audience'>
      <span class='film-rating__average' data-ref='average' hidden>{{average}}</span>
      <span class='film-rating__count' data-ref='count'>{{audience}}</span>
    </div>
    <button class='film-rating__open' type='button' data-rate-open><img
        src='{{rateIcon}}'
        alt=''
      />Оценить</button>
  </div>
  <dialog class='film-rating__dialog' aria-labelledby='film-rating-title'>
    <div class='film-rating__handle' aria-hidden='true'></div>
    <div class='film-rating__heading'><h2 class='film-rating__title' id='film-rating-title'>Ваша
        оценка</h2>
      <button
        class='film-rating__close'
        type='button'
        data-rate-close
        aria-label='Закрыть оценку'
      ><img src='{{closeIcon}}' alt='' /></button>
    </div>
    <div class='film-rating__mine'>
      {{#if user}}
        <span class='film-rating__label' id='film-rating-mine'>
          Ваша оценка<span data-ref='mineBox' hidden>:
            <span class='film-rating__value' data-ref='mine'>{{mine}}</span></span>
        </span>
        <div data-slot='scale'></div>
        <button class='film-rating__reset' type='button' data-ref='reset'>Убрать оценку</button>
      {{else}}
        <p class='film-rating__guest'>
          Чтобы поставить оценку,
          <a class='film-rating__login' href='{{loginHref}}' data-link>войдите в аккаунт</a>.
        </p>
      {{/if}}
    </div>
    <p class='film-rating__error' data-ref='error' role='alert'></p>
    <div data-slot='review'></div>
  </dialog>
</section>