<div class='home-page'>
  {{#if ready}}
    <div class='home-page__offline' role='status' data-offline='{{offline}}'>
      <img src='{{offlineIcon}}' alt='' />
      <div><strong>Нет соединения</strong><p>Показываем сохранённые данные. Изменения отправим,
          когда сеть вернётся.</p></div>
      <button type='button' data-retry><img src='{{offlineRetry}}' alt='' />Повторить</button>
    </div>
    <div class='home-page__spotlight'><div data-slot='spotlight'></div></div>
    <div data-slot='watch-later'></div>
    <section class='home-page__collections'>
      <div data-slot='collections-heading'></div>
      <p class='home-page__note'>Истории под ваше настроение.</p>
      <div class='home-page__collection-grid'></div>
    </section>
    <div data-slot='feed'></div>
  {{else}}
    <div data-slot='state'></div>
  {{/if}}
</div>