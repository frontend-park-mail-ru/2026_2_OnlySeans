<section class="collection-hero">
  <div class="collection-hero__text">
    <p class="collection-hero__eyebrow">Подборки / {{count}}</p>
    <h1 class="collection-hero__title">{{title}}</h1>
    {{#if description}}<p class="collection-hero__description">{{description}}</p>{{/if}}
    <div data-slot="back"></div>
  </div>
  <div data-slot="posters"></div>
</section>
