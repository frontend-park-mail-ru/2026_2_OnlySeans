<div class="auth-form">
  <div class="auth-form__heading" data-ref="heading">
    <h1 class="auth-form__title" id="auth-title" data-ref="title">{{title}}</h1>
    <p class="auth-form__subtitle" data-ref="subtitle">{{subtitle}}</p>
  </div>
  <p class="auth-form__error" role="alert" data-ref="error"></p>
  <form class="auth-form__form" novalidate data-ref="form">
    <div data-slot="email"></div>
    <div class="auth-form__username" data-ref="username" data-open="{{registering}}" {{#unless registering}}inert{{/unless}}>
      <div class="auth-form__username-inner"><div data-slot="username"></div></div>
    </div>
    <div data-slot="password"></div>
    <button class="auth-form__submit" type="submit" disabled data-ref="button">{{button}}</button>
  </form>
  <p class="auth-form__switch">
    <span class="auth-form__switch-text" data-ref="switchText">{{switchText}}</span>
    <a class="auth-form__switch-link" data-ref="switchLink" href="{{switchHref}}" data-link>{{switchLink}}</a>
  </p>
</div>
